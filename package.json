{
  "name": "appium-mobile-framework",
  "version": "1.0.0",
  "description": "Mobile test automation framework: WebdriverIO + Appium (UiAutomator2) + TypeScript, Screen Object Model, Android emulator in CI",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:android": "wdio run ./config/wdio.android.conf.ts",
    "test:smoke": "wdio run ./config/wdio.android.conf.ts --mochaOpts.grep @smoke",
    "test:cloud": "wdio run ./config/wdio.sauce.conf.ts",
    "appium:install-driver": "appium driver install uiautomator2"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.11",
    "@wdio/appium-service": "^10.2.0",
    "@wdio/cli": "^10.2.0",
    "@wdio/globals": "^10.2.0",
    "@wdio/junit-reporter": "^10.2.0",
    "@wdio/local-runner": "^10.2.0",
    "@wdio/mocha-framework": "^10.2.0",
    "@wdio/spec-reporter": "^10.2.0",
    "@wdio/types": "^10.2.0",
    "appium": "^3.9.1",
    "appium-uiautomator2-driver": "^8.7.3",
    "typescript": "^7.0.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
